{
  "name": "squadbot",
  "version": "0.1.0",
  "private": true,
  "description": "SquadBot: bot de organizacao para squads no Discord, com dashboard web.",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:bot": "npm run dev --workspace @squadbot/bot",
    "dev:web": "npm run dev --workspace @squadbot/web",
    "build": "npm run build --workspaces --if-present",
    "build:bot": "npm run build --workspace @squadbot/bot",
    "build:web": "npm run build --workspace @squadbot/web",
    "start:bot": "npm run start --workspace @squadbot/bot",
    "start:web": "npm run start --workspace @squadbot/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
