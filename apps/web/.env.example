# ---------------------------------------------------------------------------
# Dashboard web do SquadBot
# ---------------------------------------------------------------------------

# Segredo de assinatura da sessao (Auth.js).
# Gere com: npx auth secret   ou   openssl rand -base64 32
AUTH_SECRET=

# Credenciais do OAuth2 do Discord (Developer Portal > OAuth2).
# O Client ID e o mesmo Application ID usado pelo bot.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# URL publica do dashboard. Em producao atras de proxy, defina explicitamente.
# Ex.: https://squadbot-web.up.railway.app
AUTH_URL=http://localhost:3000

# Endereco da API do bot (sem barra no final).
# Local: http://localhost:3001
# Railway: use a URL privada do servico do bot, ex. http://bot.railway.internal:3001
SQUADBOT_API_URL=http://localhost:3001

# Mesmo valor de API_TOKEN configurado no bot. NUNCA exponha no cliente:
# esta variavel nao tem prefixo NEXT_PUBLIC_ justamente por isso.
SQUADBOT_API_TOKEN=
