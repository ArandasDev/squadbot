# Token do bot obtido no Discord Developer Portal (Bot > Reset Token)
DISCORD_TOKEN=

# ID da aplicação (Discord Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=

# Opcional: ID de um servidor para registrar os comandos instantaneamente em
# desenvolvimento. Em branco, os comandos sao registrados globalmente.
DISCORD_GUILD_ID=

# Caminho do arquivo SQLite. Em Docker use /app/data/squadbot.db
DATABASE_PATH=./data/squadbot.db

# Timezone padrao para novos usuarios (IANA)
DEFAULT_TIMEZONE=America/Sao_Paulo

# development | production | test
NODE_ENV=development

# Intervalo, em milissegundos, do worker de lembretes
REMINDER_INTERVAL_MS=30000

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# API REST (consumida pelo dashboard web)
# ---------------------------------------------------------------------------

# Token compartilhado entre o bot e o dashboard. Sem ele a API NAO sobe.
# Gere um valor forte com: openssl rand -hex 32
API_TOKEN=

# Porta da API. Em PaaS que injetam PORT (Railway), PORT tem precedencia.
API_PORT=3001

# Interface de escuta. 0.0.0.0 e o correto dentro de containers.
API_HOST=0.0.0.0
